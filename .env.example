# Local development uses SQLite automatically if DATABASE_URL is unset,
# and leaves the house password gate switched off.
# DATABASE_URL=postgresql://questlab:password@localhost:5432/questlab

SECRET_KEY=pick-a-long-random-string
PARENT_PIN=1234

# Shared password over the whole site. Leave unset for local use.
# HOUSEHOLD_PASSWORD=the house password
# HTTPS_ONLY=true          # only send the session cookie over HTTPS
